{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "piano-block/piano",
	"version": "2.10.0",
	"title": "Piano",
	"description": "Play a variety of tones using the piano keyboard.",
	"category": "media",
	"keywords": [ "audio", "music", "piano" ],
	"icon": "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' fill='black' viewBox='0 0 24 24'><path d='M19,21c1.1,0,2-.9,2-2V5c0-1.1-.9-2-2-2H5c-1.1,0-2,.9-2,2v14c0,1.1.9,2,2,2h14ZM10,19.5v-4.5h1V4.5h2v10.5h1v4.5h-4ZM8,19.5h-2.5c-.5,0-1-.5-1-1V5.5c0-.5.5-1,1-1h1.5v10.5h1s0,4.5,0,4.5ZM16,15h1V4.5h1.5c.5,0,1,.5,1,1v13c0,.5-.5,1-1,1h-2.5v-4.5Z'/></svg>",
	"attributes": {
		"volume": {
			"type": "number",
			"default": 0
		},
		"octaveOffset": {
			"type": "number",
			"default": 0
		},
		"instrument": {
			"type": "string",
			"enum": [
				"acoustic-piano",
				"electric-piano-1",
				"electric-piano-2",
				"organ",
				"electric-guitar",
				"acoustic-guitar",
				"electric-bass",
				"acoustic-bass",
				"muted-trumpet",
				"sax",
				"flute",
				"violin",
				"harp",
				"xylophone",
				"synthesizer"
			],
			"default": "acoustic-piano"
		},
		"useSustainPedal": {
			"type": "boolean",
			"default": false
		},
		"showOnFront": {
			"type": "boolean",
			"default": false
		},
		"synthesizerSetting": {
			"type": "object",
			"default": {
				"oscillator": {
					"type": "sine"
				},
				"envelope": {
					"attack": 0.3,
					"decay": 1.0,
					"sustain": 0.5,
					"release": 1.5
				}
			}
		},
		"keyLayout": {
			"type": "string",
			"enum": [ "qwerty-1", "qwerty-2", "azerty-1" ],
			"default": "qwerty-1"
		},
		"keyIndicator": {
			"type": "string",
			"enum": [ "key", "spn", "" ],
			"default": "key"
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"color": {
			"enableContrastChecker": false,
			"text": false,
			"background": true,
			"gradients": true
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		},
		"spacing": {
			"margin": [ "top", "bottom" ]
		}
	},
	"textdomain": "piano-block",
	"viewScript": "file:view.js",
	"editorScript": "file:index.js",
	"style": [ "file:style-index.css", "wp-theme" ],
	"viewStyle": "wp-components",
	"render": "file:render.php"
}
